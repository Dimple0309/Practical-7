#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int coinChange(vector<int>& coins, int N)
{
    int m = coins.size();
    vector<vector<int>> dp(m + 1, vector<int>(N + 1, 0));
    for (int i = 0; i <= m; i++)
        dp[i][0] = 1;
    for (int i = 1; i <= m; i++)
    {
        for (int j = 1; j <= N; j++)
        {
            if (coins[i - 1] <= j)
            {
                dp[i][j] = dp[i - 1][j] +
                           dp[i][j - coins[i - 1]];
            }
            else
            {
                dp[i][j] = dp[i - 1][j];
            }
        }
    }

    return dp[m][N];
}

int main()
{
    vector<int> coins = {1, 2, 3};
    int N = 4;

    cout << "Number of ways = "
         << coinChange(coins, N) << endl;

    return 0;
}
